{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ghost AI",
  "version": "0.1.2",
  "identifier": "com.brendigo.ghostai",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ghost AI",
        "width": 1160,
        "height": 760,
        "dragDropEnabled": false,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "fullscreen": false,
        "maximized": false,
        "resizable": true,
        "backgroundColor": "#080F1A",
        "theme": "Dark",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: http: https:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost data: blob: http: https:",
        "media-src": "'self' asset: http://asset.localhost data: blob:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420",
        "object-src": "'none'",
        "frame-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "resources": [
      "resources/models_dev.json",
      "builtin-skills",
      "../legal/EULA-EN.txt",
      "../legal/COMMERCIAL-LICENSE-HR.md",
      "../legal/THIRD_PARTY_NOTICES.md"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {},
    "publisher": "Brendigo",
    "copyright": "Copyright © 2026 Brendigo",
    "homepage": "https://brendigo.com",
    "shortDescription": "Your AI. Your desktop.",
    "longDescription": "Ghost AI brings conversations, documents, research and intelligent tools into one beautifully focused workspace.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "headerImage": "windows/installer-header.bmp",
        "sidebarImage": "windows/installer-sidebar.bmp",
        "installerIcon": "icons/icon.ico"
      }
    },
    "category": "Productivity"
  },
  "plugins": {}
}
